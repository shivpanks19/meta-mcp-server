{
  "name": "meta-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for Meta Ads Manager, Business Manager, Pages/social, and Lead Ads",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "meta-mcp-server": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/http.js",
    "start:stdio": "node dist/index.js",
    "dev": "node --import tsx src/index.ts",
    "dev:http": "node --import tsx src/http.ts",
    "weekly-report": "node scripts/run-weekly-report.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "dotenv": "^16.4.5",
    "google-auth-library": "^9.14.0",
    "googleapis": "^144.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
