# Copy this file to `.env` in this same folder (project root), then fill in values.
# `.env` is gitignored — never commit it.

# Required: User or system user access token with scopes for the operations you need.
# Examples: ads_read, ads_management, business_management, pages_show_list,
# pages_read_engagement, leads_retrieval, instagram_basic, instagram_manage_insights
META_ACCESS_TOKEN=

# Optional: override Graph API version (default v21.0)
# META_GRAPH_VERSION=v21.0

# Optional: default Page access token for lead form / page endpoints when the user token cannot retrieve page-scoped data
# META_PAGE_ACCESS_TOKEN=

# --- HTTP / Railway (Streamable HTTP, stateless) ---
# PORT is set automatically on Railway; local default 8080
# PORT=8080
# Listen address (default 0.0.0.0)
# HOST=0.0.0.0
# MCP endpoint path (default /mcp)
# MCP_HTTP_PATH=/mcp
# If set, require: Authorization: Bearer <token> for POST /mcp
# MCP_AUTH_TOKEN=
# Comma-separated Host header allowlist (reduces DNS rebinding risk on public hosts)
# MCP_ALLOWED_HOSTS=your-app.up.railway.app,localhost
