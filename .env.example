# Required: User or system user access token with scopes for the operations you need.
# Examples: ads_read, ads_management, business_management, pages_show_list,
# pages_read_engagement, leads_retrieval, instagram_basic, instagram_manage_insights
META_ACCESS_TOKEN=

# Optional: override Graph API version (default v21.0)
# META_GRAPH_VERSION=v21.0

# Optional: default Page access token for lead form / page endpoints when the user token cannot retrieve page-scoped data
# META_PAGE_ACCESS_TOKEN=
