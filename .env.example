# Copy this file to `.env` in this same folder (project root), then fill in values.
# `.env` is gitignored — never commit it.

# Required: Meta Graph access token (ads_read, ads_management for weekly reports)
META_ACCESS_TOKEN=

# Optional: override Graph API version (default v21.0)
# META_GRAPH_VERSION=v21.0

# Optional: Page access token for lead forms / some page calls
# META_PAGE_ACCESS_TOKEN=

# --- Google Sheets (recommended: service account) ---
# Force service account (same as google-ads-mcp: GOOGLE_ADS_AUTH_TYPE)
GOOGLE_ADS_AUTH_TYPE=service_account
# GOOGLE_AUTH_TYPE=service_account

# Preferred on Render / headless: full service account JSON (one line)
# GOOGLE_ADS_CREDENTIALS_JSON={"type":"service_account","project_id":"...",...}

# Or path to the key file (not the OAuth token file used for Desktop login)
GOOGLE_SERVICE_ACCOUNT_PATH=/path/to/service-account.json

# Do NOT point GOOGLE_ADS_CREDENTIALS_PATH at oauth token credentials.json when using service_account

# Share each target Sheet with the service account email (client_email in the JSON).

# Default spreadsheet for sheet tools
# GOOGLE_SHEETS_SPREADSHEET_ID=

# --- OAuth (only if GOOGLE_AUTH_TYPE is not service_account) ---
# GOOGLE_ADS_CLIENT_ID=
# GOOGLE_ADS_CLIENT_SECRET=
# GOOGLE_ADS_REFRESH_TOKEN=
# GOOGLE_ADS_TOKEN_PATH=/path/to/token.json

# Weekly report config (default: config/meta-weekly-reporting.json)
# META_WEEKLY_CONFIG_PATH=

# --- HTTP / Render / Railway ---
# PORT=8080
# HOST=0.0.0.0
# MCP_HTTP_PATH=/mcp
# Shared Bearer token for remote MCP clients (401 if missing, 403 if wrong)
# MCP_SHARED_TOKEN=hexanovate_meta_2026
# Legacy alias (used only when MCP_SHARED_TOKEN is unset):
# MCP_AUTH_TOKEN=
# MCP_ALLOWED_HOSTS=your-app.onrender.com,localhost

# Cron trigger for POST /v1/meta-weekly/run
# CRON_SECRET=

# OAuth only (omit when using GOOGLE_ADS_AUTH_TYPE=service_account):
# GOOGLE_ADS_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_ADS_CLIENT_SECRET=your-client-secret
# GOOGLE_ADS_CREDENTIALS_PATH=/path/to/oauth-token.json